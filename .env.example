# ------------------------------------------------------------------
# Budget Management SaaS — environment configuration
# Copy to .env and adjust. Never commit the real .env.
# ------------------------------------------------------------------

# --- Edge / hosting -------------------------------------------------
# Local: leave as-is -> http://localhost on port 80
# Cloud: set to your domain, e.g. budget.example.com  (Caddy issues TLS automatically)
SITE_ADDRESS=http://localhost

# Published host ports for the edge (change 80 -> 8085 etc. if the host
# already uses them, then browse http://localhost:8085).
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# --- Database -------------------------------------------------------
# POSTGRES_USER is the *admin* superuser used only for first-time init.
POSTGRES_USER=budget
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=budget

# The application connects as this non-superuser role instead, because
# Postgres superusers bypass Row-Level Security (the tenant isolation
# backstop). Created automatically on first boot by deploy/postgres/.
# Avoid single quotes in the password.
APP_DB_USER=budget_app
APP_DB_PASSWORD=change-me-in-production

# --- Backend security ------------------------------------------------
# Runtime mode. "production" hides API docs/OpenAPI, requires a strong
# JWT_SECRET, and marks the refresh cookie Secure (HTTPS-only). Leave as
# "development" for the local demo; set "production" when deploying with TLS.
ENVIRONMENT=development

# REQUIRED in production. Generate with:  openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-use-32-bytes-min

# Comma-separated allowed origins for browser CORS (usually only needed for dev)
CORS_ORIGINS=http://localhost,http://localhost:5173

# Token lifetimes. Refresh tokens rotate on every use and are also
# delivered to browsers as an HttpOnly cookie (bms_refresh); API clients
# receive them in the response body.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Request budgets (single-instance limiter; see docs/MULTI-TENANCY.md)
# General API per tenant/IP ...
RATE_LIMIT_PER_MINUTE=240
# ... and the stricter credential-endpoint budget (login/register/refresh/logout) per IP.
AUTH_RATE_LIMIT_PER_MINUTE=15

# --- Behaviour -------------------------------------------------------
# Seed a demo tenant (demo / demo@example.com / Demo@12345) when the DB is empty
SEED_DEMO=true

# Logger level: debug | info | warning | error
LOG_LEVEL=info
